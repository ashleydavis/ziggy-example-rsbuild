.{
    .name = .ziggy_example_rsbuild,
    .fingerprint = 0xf47e8c1e0dc25063,
    .version = "1.0.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, at a version tag of its repository. Every other place that takes Ziggy (package.json, the Xcode projects and
        // native/android/app/build.gradle) names the same version.
        .ziggy = .{
            .path = "../../../../ziggy/.claude/worktrees/plan-config-and-state",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "backend",
        "native",
    },
}
