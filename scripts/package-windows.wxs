<?xml version="1.0" encoding="UTF-8"?>
<!--
    The MSI installer for the Ziggy Rsbuild example on Windows, compiled by WiX Toolset 3 (candle and light). Built by
    package-windows.sh, which defines:
        Version     the app's version, as major.minor.build
        SourceDir   the directory holding ziggy-example-rsbuild.exe, which is the whole app
    The installer is unsigned and installs for the current user only, into %LOCALAPPDATA%\Programs\Ziggy Rsbuild example, so it
    needs no administrator rights. It adds a Start menu shortcut, and Windows Installer adds the entry in Installed apps.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!-- The UpgradeCode stays the same for every version, so installing a newer one replaces the older one. -->
    <Product Id="*" Name="Ziggy Rsbuild example" Language="1033" Version="$(var.Version)" Manufacturer="Ziggy" UpgradeCode="D2A20575-1D91-4B68-B3EB-0B8582F4CFCF">
        <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64" />
        <MajorUpgrade DowngradeErrorMessage="A newer version of Ziggy Rsbuild example is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="ProgramsFolder" Name="Programs">
                    <Directory Id="INSTALLFOLDER" Name="Ziggy Rsbuild example" />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder" />
        </Directory>

        <!--
            A per-user component's key path must be a registry value under HKCU rather than a file, which is what Windows
            Installer checks to know whether the component is installed. RemoveFolder takes the folders away on uninstall when
            they are left empty.
        -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="AppExecutable" Guid="587CB574-7F1E-431B-956D-F60FDF7B32FB" Win64="yes">
                <File Id="ZiggyExampleRsbuildExe" Source="$(var.SourceDir)\ziggy-example-rsbuild.exe" KeyPath="no" />
                <RegistryValue Root="HKCU" Key="Software\dev.ziggy.examplersbuild" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
                <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
                <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ProgramMenuFolder">
            <Component Id="StartMenuShortcut" Guid="799BD181-0BD7-42F3-9C5D-06003DE0ADB5" Win64="yes">
                <Shortcut Id="ZiggyExampleRsbuildShortcut" Name="Ziggy Rsbuild example" Target="[INSTALLFOLDER]ziggy-example-rsbuild.exe" WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU" Key="Software\dev.ziggy.examplersbuild" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <Feature Id="App" Title="Ziggy Rsbuild example" Level="1">
            <ComponentRef Id="AppExecutable" />
            <ComponentRef Id="StartMenuShortcut" />
        </Feature>
    </Product>
</Wix>
