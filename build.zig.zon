.{
    .name = .ziggy_example_rsbuild,
    .fingerprint = 0xf47e8c1e0dc25063,
    .version = "1.0.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, from the local checkout beside this repository. package.json and shells/android/settings.gradle take the same
        // checkout. The Xcode projects still take the version tag.
        .ziggy = .{
            .path = "../ziggy",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "core",
        "shells",
    },
}
